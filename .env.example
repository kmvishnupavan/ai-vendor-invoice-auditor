# ==========================================================
# InvoiceGuard — Environment Configuration
# ==========================================================

# 1. Relational Database Configuration
# Options:
# PostgreSQL (Default Recommended):
# DB_URL=jdbc:postgresql://localhost:5432/invoiceguard_db
# DB_USERNAME=postgres
# DB_PASSWORD=your_postgres_password
#
# MySQL:
# DB_URL=jdbc:mysql://localhost:3306/invoiceguard_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# DB_USERNAME=root
# DB_PASSWORD=your_mysql_password
#
# H2 In-Memory (Zero-setup local testing mode, automatically selected if DB_URL is omitted):
DB_URL=jdbc:h2:mem:invoiceguard_db;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1
DB_USERNAME=sa
DB_PASSWORD=

# 2. AI Model Configuration (Gemini API)
# Get a free Gemini API key from https://aistudio.google.com/
# Leave empty or set to MOCK_MODE to use local high-precision extraction engine for offline demos
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=15000

# 3. Server Configuration
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# 4. Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
